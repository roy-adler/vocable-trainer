DATABASE_URL="file:./dev.db"
DATA_DIR=./data
TZ=Europe/Berlin
# OLLAMA_BASE_URL=http://100.x.y.z:11434
# OLLAMA_MODEL=llama3.1
# Seeds default only when /data/settings.json has no ollamaModel yet; UI choice persists on the volume.
# MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Authority: common (personal + work/school), consumers (personal only),
# organizations, or a tenant GUID. Must match the account you sign in with.
# MICROSOFT_TENANT=common
# Narrow the scopes to isolate a consent problem from a broken registration:
# MICROSOFT_SCOPES=User.Read offline_access
